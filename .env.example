# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Overpass API configuration for OpenStreetMap imports:
# - Default uses the public Overpass API (https://overpass-api.de/api/interpreter).
# - For local Docker Overpass development (via Vite proxy in vite.config.ts):
#   VITE_OVERPASS_URL="/overpass/api/interpreter"
#   OVERPASS_LOCAL_TARGET="http://localhost:12345"
# - Per-city overrides (optional; dev mode automatically routes Teresina to /overpass-teresina):
#   VITE_OVERPASS_URL_NYC="/overpass/api/interpreter"
#   VITE_OVERPASS_URL_TERESINA="/overpass-teresina/api/interpreter"
#   OVERPASS_TERESINA_TARGET="http://localhost:12346"

